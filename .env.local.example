# 짱샘 유튜브 메이커 환경변수
# 이 파일을 .env.local 로 복사한 뒤 실제 키를 채워 넣으세요.
# .env.local 은 절대 커밋하지 마세요 (.gitignore 에 포함됨).

# Claude (대본·메타데이터·썸네일 문구) — Opus 4.8
ANTHROPIC_API_KEY=

# Gemini (인포그래픽·썸네일 이미지 생성)
GEMINI_API_KEY=

# 로컬 실행 시 산출물을 저장할 폴더 (기본: ./output)
# Vercel 등 서버리스 배포 환경에서는 무시되고, 앱 내 다운로드만 동작합니다.
OUTPUT_DIR=./output
